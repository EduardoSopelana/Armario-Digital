rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Perfil público: cualquier usuario con sesión puede leerlo (para buscar amigos).
    // Solo su dueño puede crearlo o modificarlo. No contiene el correo.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;

      // Ajustes privados (notificaciones...): solo el dueño
      match /private/{doc} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Alias únicos: el documento aliases/{alias} guarda quién lo tiene.
    // "create" solo funciona si el documento NO existe, y eso garantiza que no haya dos iguales.
    match /aliases/{alias} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && alias.matches('^[a-z0-9._]{3,20}$')
                    && request.resource.data.keys().hasOnly(['uid'])
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if false;
    }
  }
}
